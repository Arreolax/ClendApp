<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Morning!!"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/hey_comic"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp" />

            <!-- Calendar Row -->
            <LinearLayout
                android:id="@+id/calendar_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false"
                android:layout_marginBottom="32dp">

                <!-- Example Days -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mo" android:textSize="12sp" android:textColor="@color/text_light"/>
                    <LinearLayout android:id="@+id/dots_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="31" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu" android:textSize="12sp" android:textColor="@color/text_light"/>
                    <LinearLayout android:id="@+id/dots_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textSize="12sp" android:textColor="@color/text_light"/>
                    <LinearLayout android:id="@+id/dots_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:background="@drawable/bg_day_active"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Th" android:textSize="14sp" android:textColor="@color/white"/>
                    <LinearLayout android:id="@+id/dots_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fr" android:textSize="12sp" android:textColor="@color/text_light"/>
                    <LinearLayout android:id="@+id/dots_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sa" android:textSize="12sp" android:textColor="@color/text_light"/>
                    <LinearLayout android:id="@+id/dots_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Su" android:textSize="12sp" android:textColor="@color/text_light"/>
                    <LinearLayout android:id="@+id/dots_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Points Resume Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_outline"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stats"
                    android:fontFamily="@font/hey_comic"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Calculator Score -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/bg_blue_card"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_math"
                            app:tint="@color/text_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculator"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_resume_calculator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 points"
                            android:textColor="@color/text_white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Study Score -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/bg_blue_card">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/text_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Study"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tv_resume_study"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 points"
                            android:textColor="@color/text_white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Rank Info - Centered Below -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/bg_gray">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Rank"
                        android:textColor="@color/text_light"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_resume_rank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Potato"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:fontFamily="@font/hey_comic"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Reminder Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending tasks"
                    android:fontFamily="@font/hey_comic"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_reminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_empty_reminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="No pending tasks for today"
                    android:textColor="@color/text_light"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Notes Card Section -->
            <LinearLayout
                android:id="@+id/card_notes_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_outline"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notes"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tv_notes_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notes"
                    android:fontFamily="@font/hey_comic"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/tv_notes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="26dp"
                    android:minHeight="26dp"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_categoria"
                    android:backgroundTint="@color/cat_teal_bg"
                    android:paddingHorizontal="8dp"
                    android:text="0"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="»"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>