<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_section_outline"
    android:padding="16dp">

    <View
        android:id="@+id/view_category_indicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_profile_circle"
        android:backgroundTint="#00C853"
        app:layout_constraintBottom_toBottomOf="@+id/tv_task_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_task_category" />

    <TextView
        android:id="@+id/tv_task_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Work"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="italic"
        app:layout_constraintStart_toEndOf="@+id/view_category_indicator"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_task_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="10:00-13:00"
        android:textColor="@color/text_light"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_task_category"
        app:layout_constraintStart_toEndOf="@+id/tv_task_category"
        app:layout_constraintTop_toTopOf="@+id/tv_task_category" />

    <ImageView
        android:id="@+id/iv_status_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tv_task_time"
        app:layout_constraintStart_toEndOf="@+id/tv_task_time"
        app:layout_constraintTop_toTopOf="@+id/tv_task_time" />

    <ImageButton
        android:id="@+id/btn_task_options"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_name"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_muted" />

    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Task #1"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btn_task_options"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_task_category" />

    <TextView
        android:id="@+id/tv_task_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Lorem ipsum..."
        android:textColor="@color/text_light"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_task_title" />

</androidx.constraintlayout.widget.ConstraintLayout>