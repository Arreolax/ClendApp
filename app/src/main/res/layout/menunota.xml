<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Tarjeta del menu -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_menu_popup"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_menu_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hey_comic"
            android:text="Lorem ipsum dolor sit amet"
            android:textColor="#6C63FF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/underline_titulo"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="#F5C878"
            app:layout_constraintEnd_toEndOf="@+id/tv_menu_titulo"
            app:layout_constraintStart_toStartOf="@+id/tv_menu_titulo"
            app:layout_constraintTop_toBottomOf="@+id/tv_menu_titulo" />

        <TextView
            android:id="@+id/opcion_eliminar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill_opcion"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Delete"
            android:textColor="#3A3A45"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/underline_titulo" />

        <TextView
            android:id="@+id/opcion_editar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_opcion"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Edit"
            android:textColor="#3A3A45"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/opcion_eliminar" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Boton circular para cerrar el menu, flotando sobre la esquina -->

</androidx.constraintlayout.widget.ConstraintLayout>