<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#5C9AFF" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hey_comic"
        android:text="Settings"
        android:textColor="#5C9AFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customization"
                android:textColor="#7E70FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Background Music"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_music_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Unlock 30 streak points to change the music."
                        android:textColor="@color/text_light"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rg_music_selection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <!-- Default Music -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_music_default" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Subwoofer Lullaby (Default)" android:buttonTint="#7E70FF"/>
                            <ImageView android:id="@+id/iv_preview_default" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_volume_up" android:padding="4dp" app:tint="#BDBDBD" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>

                        <!-- Smetana -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                            <RadioButton android:id="@+id/rb_music_smetana" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Smetana - The Moldau" android:buttonTint="#7E70FF"/>
                            <ImageView android:id="@+id/iv_preview_smetana" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_volume_up" android:padding="4dp" app:tint="#BDBDBD" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>

                        <!-- Vivaldi -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                            <RadioButton android:id="@+id/rb_music_vivaldi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Vivaldi - Four Seasons" android:buttonTint="#7E70FF"/>
                            <ImageView android:id="@+id/iv_preview_vivaldi" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_volume_up" android:padding="4dp" app:tint="#BDBDBD" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>

                        <!-- Cute Ringtone -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                            <RadioButton android:id="@+id/rb_music_ringtone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cute Ringtone" android:buttonTint="#7E70FF"/>
                            <ImageView android:id="@+id/iv_preview_ringtone" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_volume_up" android:padding="4dp" app:tint="#BDBDBD" android:clickable="true" android:focusable="true"/>
                        </LinearLayout>

                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
